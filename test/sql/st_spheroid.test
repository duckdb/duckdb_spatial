require spatial

statement ok
SET geometry_always_xy = true;

query I
SELECT ST_DWithin_Spheroid(
    st_point(-73.7797, 40.6446),
    st_point(4.7725, 52.3130),
    6000000.0
);
----
true

# Points within 5000km should return false
query I
SELECT ST_DWithin_Spheroid(
    st_point(-73.7797, 40.6446),
    st_point(4.7725, 52.3130),
    5000000.0
);
----
false

# Same point should be within any positive distance
query I
SELECT ST_DWithin_Spheroid(
    st_point(-73.7797, 40.6446),
    st_point(-73.7797, 40.6446),
    0.0
);
----
true

# Same point should be within distance 0
query I
SELECT ST_DWithin_Spheroid(
    st_point(0.0, 0.0),
    st_point(0.0, 0.0),
    0.0
);
----
true

# Very close points within 1 meter
query I
SELECT ST_DWithin_Spheroid(
    st_point(4.892360, 52.373123),
    st_point(4.892361, 52.373124),
    1.0
);
----
true

# Verify consistency with ST_Distance_Spheroid
query I
SELECT ST_DWithin_Spheroid(
    st_point(-73.7797, 40.6446),
    st_point(4.7725, 52.3130),
    ST_Distance_Spheroid(
        st_point(-73.7797, 40.6446),
        st_point(4.7725, 52.3130)
    )
);
----
true

# Test with NULL inputs
query I
SELECT ST_DWithin_Spheroid(NULL::POINT_2D, st_point(4.7725, 52.3130), 6000000.0);
----
NULL

query I
SELECT ST_DWithin_Spheroid(st_point(-73.7797, 40.6446), NULL::POINT_2D, 6000000.0);
----
NULL

query I
SELECT ST_DWithin_Spheroid(st_point(-73.7797, 40.6446), st_point(4.7725, 52.3130), NULL);
----
NULL